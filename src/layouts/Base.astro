---
import '../styles/global.css';
import { Font } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BandeauAnnonce from '../components/BandeauAnnonce.astro';
import { annonce } from '../config/site';
import antiFlash from '../scripts/theme-anti-flash.js?raw';

interface Props {
  titre: string;
  description: string;
  typeOg?: 'website' | 'article';
  sansSuffixe?: boolean;
  image?: string;
  /** Texte alternatif de l'image de partage. */
  imageAlt?: string;
  /** Dimensions de l'image de partage ; 1200 × 630 pour les images générées. */
  imageLargeur?: number;
  imageHauteur?: number;
  noindex?: boolean;
  habillage?: 'site' | 'application';
  /** Objets JSON-LD (schema.org) à insérer dans la page. */
  donneesStructurees?: Record<string, unknown>[];
  datePublication?: Date;
  dateModification?: Date;
}

const {
  titre,
  description,
  typeOg = 'website',
  sansSuffixe = false,
  image = '/og-default.png',
  imageAlt = 'Bresnik, logiciels complémentaires de Sage 100',
  imageLargeur = 1200,
  imageHauteur = 630,
  noindex = false,
  habillage = 'site',
  donneesStructurees = [],
  datePublication,
  dateModification,
} = Astro.props;
const titreComplet = sansSuffixe ? titre : `${titre} · Bresnik`;
const urlCanonique = new URL(Astro.url.pathname, Astro.site);
const urlImage = new URL(image, Astro.site);
const jetonAnalytics = import.meta.env.PUBLIC_CF_BEACON_TOKEN;
---
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline set:html={antiFlash}></script>
    <title>{titreComplet}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#faf8f4" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#141a26" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-192.png" sizes="192x192" type="image/png" />
    <link rel="icon" href="/favicon-512.png" sizes="512x512" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={urlCanonique} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="Blog Bresnik" href={new URL('/rss.xml', Astro.site)} />
    <meta property="og:type" content={typeOg} />
    <meta property="og:title" content={titreComplet} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={urlCanonique} />
    <meta property="og:site_name" content="Bresnik" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:image" content={urlImage} />
    <meta property="og:image:width" content={String(imageLargeur)} />
    <meta property="og:image:height" content={String(imageHauteur)} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    {typeOg === 'article' && datePublication && <meta property="article:published_time" content={datePublication.toISOString()} />}
    {typeOg === 'article' && (dateModification ?? datePublication) && <meta property="article:modified_time" content={(dateModification ?? datePublication)!.toISOString()} />}
    {typeOg === 'article' && <meta property="article:author" content="Nicolas Bresson" />}
    {donneesStructurees.map((objet) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(objet)}></script>
    ))}
    <meta name="generator" content={Astro.generator} />
    <Font cssVariable="--police-titres" preload />
    <Font cssVariable="--police-texte" preload />
    <Font cssVariable="--police-technique" />
    <slot name="tete" />
  </head>
  <body id="haut" class="min-h-screen bg-papier font-texte text-encre">
    <a
      href="#contenu"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-bouton focus:bg-cobalt focus:px-4 focus:py-2 focus:font-semibold focus:text-blanc"
    >
      Aller au contenu
    </a>
    {habillage === 'site' && annonce && <BandeauAnnonce texte={annonce.texte} href={annonce.href} libelle={annonce.libelle} />}
    {habillage === 'site' && <Header />}
    <main id="contenu">
      <slot />
    </main>
    {habillage === 'site' && <Footer />}
    {jetonAnalytics && (
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: jetonAnalytics })}
      ></script>
    )}
  </body>
</html>
