---
import Marque from './Marque.astro';
---
<footer class="mt-16 border-t border-ligne md:mt-24">
  <div class="conteneur flex flex-col gap-4 py-7 md:flex-row md:items-center md:justify-between md:gap-6 md:py-8">
    <div class="flex flex-col gap-1.5">
      <Marque taille="pied" />
      <p class="text-[13px] leading-[1.5] text-encre-2 md:text-[14px]">
        © 2026 Bresnik. Logiciels complémentaires pour l'écosystème Sage 100. Éditeur indépendant, sans lien avec Sage Group plc.
      </p>
    </div>
    <nav aria-label="Plan du site">
      <div class="flex flex-col gap-2 md:items-end">
        <ul class="flex flex-wrap gap-4 md:gap-6">
          <li><a href="/produits/" class="inline-block py-3 text-[14px] text-encre-2 hover:text-cobalt">Produits</a></li>
          <li><a href="/conseil/" class="inline-block py-3 text-[14px] text-encre-2 hover:text-cobalt">Conseil</a></li>
          <li><a href="/blog/" class="inline-block py-3 text-[14px] text-encre-2 hover:text-cobalt">Blog</a></li>
          <li><a href="/contact/" class="inline-block py-3 text-[14px] text-encre-2 hover:text-cobalt">Contact</a></li>
        </ul>
        <ul class="flex flex-wrap gap-4 md:gap-6">
          <li><a href="/mentions-legales/" class="inline-block py-3 text-[14px] text-encre-2 hover:text-cobalt">Mentions légales</a></li>
          <li><a href="/confidentialite/" class="inline-block py-3 text-[14px] text-encre-2 hover:text-cobalt">Confidentialité</a></li>
          <li><a href="/rss.xml" class="inline-block py-3 text-[14px] text-encre-2 hover:text-cobalt">Flux RSS</a></li>
        </ul>
      </div>
    </nav>
  </div>
</footer>
