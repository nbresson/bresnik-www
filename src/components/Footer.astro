---
import Marque from './Marque.astro';
import Icone from './Icone.astro';
import type { NomIcone } from './Icone.astro';
import { produitsPublies } from '../lib/catalogue';

const produits = await produitsPublies();
const classeLien = 'inline-block py-1.5 text-[14px] text-encre-2 hover:text-cobalt';
const colonnes: { titre: string; liens: { href: string; libelle: string; icone?: NomIcone }[] }[] = [
  { titre: 'Produits', liens: produits.map((p) => ({ href: `/produits/${p.id}/`, libelle: p.data.nom })) },
  {
    titre: 'Bresnik',
    liens: [
      { href: '/', libelle: 'Accueil' },
      { href: '/produits/', libelle: 'Tous les produits' },
      { href: '/conseil/', libelle: 'Conseil Sage 100' },
      { href: '/blog/', libelle: 'Blog' },
    ],
  },
  {
    titre: 'Contact',
    liens: [
      { href: '/contact/', libelle: 'Demander une démo', icone: 'calendrier' },
      { href: '/contact/', libelle: 'Poser une question', icone: 'courrier' },
    ],
  },
  {
    titre: 'Informations',
    liens: [
      { href: '/mentions-legales/', libelle: 'Mentions légales' },
      { href: '/confidentialite/', libelle: 'Confidentialité' },
      { href: '/rss.xml', libelle: 'Flux RSS', icone: 'rss' },
    ],
  },
];
---
<footer class="mt-16 border-t border-ligne md:mt-24">
  <div class="conteneur flex flex-col gap-10 py-10 md:py-12">
    <nav aria-label="Plan du site" class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      {colonnes.map((colonne) => (
        <div class="flex flex-col gap-2">
          <p class="eyebrow">{colonne.titre}</p>
          <ul class="flex flex-col">
            {colonne.liens.map((lien) => (
              <li>
                <a href={lien.href} class={`${classeLien} ${lien.icone ? 'inline-flex items-center gap-1.5' : ''}`}>
                  {lien.icone && <Icone nom={lien.icone} taille={16} class="shrink-0" />}
                  {lien.libelle}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </nav>
    <div class="flex flex-col gap-4 border-t border-ligne pt-6 md:flex-row md:items-center md:justify-between md:gap-6">
      <div class="flex flex-col gap-1.5">
        <Marque taille="pied" />
        <p class="text-[13px] leading-[1.5] text-encre-2 md:text-[14px]">
          © 2026 Bresnik. Logiciels complémentaires pour l'écosystème Sage 100. Éditeur indépendant, sans lien avec Sage Group plc.
        </p>
      </div>
      <a href="#haut" class="inline-block py-3 text-[14px] text-encre-2 hover:text-cobalt">Retour en haut</a>
    </div>
  </div>
</footer>
