---
import Marque from './Marque.astro';
import Bouton from './Bouton.astro';
import Icone from './Icone.astro';
import type { NomIcone } from './Icone.astro';
import SelecteurTheme from './SelecteurTheme.astro';

const liens: { href: string; libelle: string; icone: NomIcone }[] = [
  { href: '/produits/', libelle: 'Produits', icone: 'tableau-de-bord' },
  { href: '/conseil/', libelle: 'Conseil', icone: 'consultant' },
  { href: '/blog/', libelle: 'Blog', icone: 'document' },
  { href: '/contact/', libelle: 'Contact', icone: 'courrier' },
];
const cheminCourant = Astro.url.pathname;
const estActif = (href: string) => cheminCourant.startsWith(href);
const classeLien = (href: string) =>
  estActif(href)
    ? 'border-b-2 border-cobalt font-semibold text-cobalt'
    : 'font-semibold text-encre hover:text-cobalt';
---
<header class="border-b border-ligne bg-papier">
  <div class="conteneur flex h-16 items-center justify-between lg:h-20">
    <Marque />
    <div class="hidden items-center gap-8 lg:flex">
      <nav aria-label="Navigation principale" class="flex items-center gap-8">
        {liens.map((lien) => (
          <a href={lien.href} aria-current={estActif(lien.href) ? 'page' : undefined} class={`inline-flex items-center gap-1.5 text-[16px] py-2.5 ${classeLien(lien.href)}`}>
            <Icone nom={lien.icone} taille={16} class="shrink-0" />
            {lien.libelle}
          </a>
        ))}
      </nav>
      <SelecteurTheme id="theme-desktop" />
      <Bouton href="/contact/" taille="compact">Demander une démo</Bouton>
    </div>
    <div class="flex items-center gap-1 lg:hidden">
      <SelecteurTheme id="theme-mobile" />
      <button
        id="bouton-menu"
        type="button"
        class="inline-flex h-11 w-11 items-center justify-center rounded-bouton border border-ligne bg-blanc text-encre"
        aria-expanded="false"
        aria-controls="menu-mobile"
        aria-label="Menu"
      >
        <Icone nom="menu" taille={22} />
      </button>
    </div>
  </div>
  <nav id="menu-mobile" aria-label="Navigation mobile" hidden class="border-t border-ligne lg:hidden">
    <ul class="conteneur flex flex-col gap-1 py-3">
      {liens.map((lien) => (
        <li>
          <a href={lien.href} aria-current={estActif(lien.href) ? 'page' : undefined} class={`flex items-center gap-2 py-3 text-[17px] ${classeLien(lien.href)}`}>
            <Icone nom={lien.icone} taille={18} class="shrink-0" />
            {lien.libelle}
          </a>
        </li>
      ))}
      <li class="pt-2">
        <Bouton href="/contact/" plein>Demander une démo</Bouton>
      </li>
    </ul>
  </nav>
</header>

<script>
  const bouton = document.getElementById('bouton-menu');
  const menu = document.getElementById('menu-mobile');
  const entete = bouton?.closest('header');
  if (bouton && menu && entete) {
    const estOuvert = () => bouton.getAttribute('aria-expanded') === 'true';
    const basculer = (ouvert: boolean, focaliser = false) => {
      bouton.setAttribute('aria-expanded', String(ouvert));
      menu.hidden = !ouvert;
      if (ouvert) menu.querySelector<HTMLElement>('a, button')?.focus();
      else if (focaliser) bouton.focus();
    };
    bouton.addEventListener('click', () => basculer(!estOuvert()));
    // Échap referme et rend le focus au bouton.
    document.addEventListener('keydown', (evenement) => {
      if (evenement.key === 'Escape' && estOuvert()) basculer(false, true);
    });
    // Un clic hors de l'en-tête referme le menu.
    document.addEventListener('click', (evenement) => {
      if (estOuvert() && !entete.contains(evenement.target as Node)) basculer(false);
    });
    // Le focus qui sort de l'en-tête (tabulation) referme aussi le menu.
    document.addEventListener('focusin', (evenement) => {
      if (estOuvert() && !entete.contains(evenement.target as Node)) basculer(false);
    });
    // Passage à la largeur desktop : le menu mobile n'a plus lieu d'être.
    const desktop = window.matchMedia('(min-width: 1024px)');
    desktop.addEventListener('change', () => {
      if (desktop.matches && estOuvert()) basculer(false);
    });
  }
</script>
