---
import Marque from './Marque.astro';
import Bouton from './Bouton.astro';
import Icone from './Icone.astro';
import type { NomIcone } from './Icone.astro';
import SelecteurTheme from './SelecteurTheme.astro';
import { getCollection } from 'astro:content';
import { filtrerPublies } from '../lib/blog';

// Le lien Blog n'apparaît qu'à partir du premier article publié.
const blogPublie = filtrerPublies(await getCollection('blog'), import.meta.env.DEV).length > 0;

const tousLesLiens: { href: string; libelle: string; icone: NomIcone }[] = [
  { href: '/produits/', libelle: 'Produits', icone: 'tableau-de-bord' },
  { href: '/conseil/', libelle: 'Conseil', icone: 'consultant' },
  { href: '/blog/', libelle: 'Blog', icone: 'document' },
  { href: '/contact/', libelle: 'Contact', icone: 'courrier' },
];
const liens = tousLesLiens.filter((lien) => lien.href !== '/blog/' || blogPublie);
const cheminCourant = Astro.url.pathname;
const estActif = (href: string) => (href === '/' ? cheminCourant === '/' : cheminCourant.startsWith(href));
const classeLien = (href: string) =>
  estActif(href)
    ? 'bg-cobalt-teinte/80 text-cobalt font-semibold'
    : 'font-medium text-encre hover:text-cobalt hover:bg-papier-2';
---
<header class="sticky top-0 z-40 border-b border-ligne/80 bg-papier/90 backdrop-blur-md transition-colors">
  <div class="conteneur flex h-16 items-center justify-between lg:h-20">
    <Marque />
    <div class="hidden items-center gap-6 lg:flex">
      <nav aria-label="Navigation principale" class="flex items-center gap-1.5 p-1 rounded-xl bg-papier-2/50 border border-ligne/50">
        {liens.map((lien) => (
          <a
            href={lien.href}
            aria-current={estActif(lien.href) ? 'page' : undefined}
            class={`inline-flex items-center gap-2 text-[15px] px-3.5 py-1.5 rounded-lg transition-all ${classeLien(lien.href)}`}
          >
            <Icone nom={lien.icone} taille={16} class="shrink-0" />
            {lien.libelle}
            {lien.href === '/produits/' && (
              <span class="inline-flex items-center justify-center rounded-full bg-cobalt/15 px-1.5 py-0.5 text-[11px] font-semibold font-technique text-cobalt border border-cobalt/25">
                5
              </span>
            )}
          </a>
        ))}
      </nav>
      <div class="h-6 w-px bg-ligne"></div>
      <div class="flex items-center gap-3">
        <SelecteurTheme id="theme-desktop" />
        <Bouton href="/contact/" taille="compact">Demander une démo</Bouton>
      </div>
    </div>
    <div class="flex items-center gap-2 lg:hidden">
      <SelecteurTheme id="theme-mobile" />
      <button
        id="bouton-menu"
        type="button"
        class="inline-flex h-11 w-11 items-center justify-center rounded-bouton border border-ligne bg-blanc text-encre"
        aria-expanded="false"
        aria-controls="menu-mobile"
        aria-label="Menu"
      >
        <Icone nom="menu" taille={22} />
      </button>
    </div>
  </div>
  <nav id="menu-mobile" aria-label="Navigation mobile" hidden class="border-t border-ligne bg-papier/95 backdrop-blur-md lg:hidden">
    <ul class="conteneur flex flex-col gap-1.5 py-4">
      {liens.map((lien) => (
        <li>
          <a
            href={lien.href}
            aria-current={estActif(lien.href) ? 'page' : undefined}
            class={`flex items-center justify-between rounded-lg px-3 py-2.5 text-[16px] ${classeLien(lien.href)}`}
          >
            <span class="flex items-center gap-2.5">
              <Icone nom={lien.icone} taille={18} class="shrink-0" />
              {lien.libelle}
            </span>
            {lien.href === '/produits/' && (
              <span class="inline-flex items-center justify-center rounded-full bg-cobalt/15 px-2 py-0.5 text-[11px] font-semibold font-technique text-cobalt border border-cobalt/25">
                5 logiciels
              </span>
            )}
          </a>
        </li>
      ))}
      <li class="pt-3 border-t border-ligne/60 mt-1">
        <Bouton href="/contact/" plein>Demander une démo</Bouton>
      </li>
    </ul>
  </nav>
</header>

<script>
  const bouton = document.getElementById('bouton-menu');
  const menu = document.getElementById('menu-mobile');
  const entete = bouton?.closest('header');
  if (bouton && menu && entete) {
    const estOuvert = () => bouton.getAttribute('aria-expanded') === 'true';
    const basculer = (ouvert: boolean, focaliser = false) => {
      bouton.setAttribute('aria-expanded', String(ouvert));
      menu.hidden = !ouvert;
      if (ouvert) menu.querySelector<HTMLElement>('a, button')?.focus();
      else if (focaliser) bouton.focus();
    };
    bouton.addEventListener('click', () => basculer(!estOuvert()));
    // Échap referme et rend le focus au bouton.
    document.addEventListener('keydown', (evenement) => {
      if (evenement.key === 'Escape' && estOuvert()) basculer(false, true);
    });
    // Un clic hors de l'en-tête referme le menu.
    document.addEventListener('click', (evenement) => {
      if (estOuvert() && !entete.contains(evenement.target as Node)) basculer(false);
    });
    // Le focus qui sort de l'en-tête (tabulation) referme aussi le menu.
    document.addEventListener('focusin', (evenement) => {
      if (estOuvert() && !entete.contains(evenement.target as Node)) basculer(false);
    });
    // Passage à la largeur desktop : le menu mobile n'a plus lieu d'être.
    const desktop = window.matchMedia('(min-width: 1024px)');
    desktop.addEventListener('change', () => {
      if (desktop.matches && estOuvert()) basculer(false);
    });
  }
</script>
