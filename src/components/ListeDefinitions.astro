---
import Icone from './Icone.astro';
import type { NomIcone } from './Icone.astro';

interface Props {
  elements: { libelle: string; valeur: string; icone?: NomIcone }[];
  class?: string;
}

const { elements, class: classe = '' } = Astro.props;
---
<dl class={`grid grid-cols-[max-content_minmax(0,1fr)] gap-x-[18px] gap-y-3 text-[15px] ${classe}`}>
  {elements.map((element) => (
    <>
      <dt class="pt-[3px] font-technique text-[12px] uppercase tracking-[0.04em] text-encre-2">{element.libelle}</dt>
      <dd class="flex items-start gap-2 font-semibold">
        {element.icone && <Icone nom={element.icone} taille={18} class="mt-px shrink-0 text-cobalt" />}
        <span>{element.valeur}</span>
      </dd>
    </>
  ))}
</dl>
