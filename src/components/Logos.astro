---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  titre?: string;
  logos: { nom: string; image?: ImageMetadata; href?: string }[];
  class?: string;
}

const { titre, logos, class: classe = '' } = Astro.props;
---
<div class={`flex flex-col gap-4 ${classe}`}>
  {titre && <p class="eyebrow">{titre}</p>}
  <ul class="grid grid-cols-2 gap-4 md:grid-cols-3 lg:grid-cols-6">
    {logos.map((logo) => (
      <li class="flex h-20 items-center justify-center rounded-carte border border-ligne bg-blanc px-4">
        {logo.image ? (
          logo.href ? (
            <a href={logo.href} class="flex items-center justify-center"><Image src={logo.image} alt={logo.nom} height={40} class="max-h-10 w-auto" /></a>
          ) : (
            <Image src={logo.image} alt={logo.nom} height={40} class="max-h-10 w-auto" />
          )
        ) : (
          <span class="technique text-center">{logo.nom}</span>
        )}
      </li>
    ))}
  </ul>
</div>
