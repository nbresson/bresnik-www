---
export type NomIcone =
  | 'fleche' | 'coche' | 'menu' | 'information' | 'avertissement' | 'erreur' | 'chevron' | 'chargement'
  | 'utilisateur' | 'recherche' | 'filtre' | 'tri' | 'tri-croissant' | 'tri-decroissant' | 'plus' | 'corbeille'
  | 'crayon' | 'oeil' | 'oeil-barre' | 'telecharger' | 'televerser' | 'calendrier' | 'horloge' | 'fermer'
  | 'parametres' | 'deconnexion' | 'tableau-de-bord' | 'document' | 'imprimer' | 'dossier' | 'cloche'
  | 'tendance-haut' | 'tendance-bas' | 'points'
  | 'soleil' | 'lune' | 'ecran' | 'pause' | 'lecture';

interface Props {
  nom: NomIcone;
  taille?: number;
  class?: string;
}

const { nom, taille = 18, class: classe = '' } = Astro.props;

const traces: Record<NomIcone, string[]> = {
  fleche: ['M5 12h14', 'M13 6l6 6-6 6'],
  coche: ['M20 6L9 17l-5-5'],
  menu: ['M4 7h16', 'M4 12h16', 'M4 17h16'],
  information: ['circle:12,12,9', 'M12 11v5', 'M12 8h.01'],
  avertissement: ['M12 4l9 16H3z', 'M12 10v4', 'M12 17h.01'],
  erreur: ['circle:12,12,9', 'M15 9l-6 6', 'M9 9l6 6'],
  chevron: ['M6 9l6 6 6-6'],
  chargement: ['M21 12a9 9 0 1 1-6.2-8.6'],
  utilisateur: ['circle:12,8,4', 'M4 21c0-4 3.6-7 8-7s8 3 8 7'],
  recherche: ['circle:11,11,7', 'M20 20l-3.5-3.5'],
  filtre: ['M4 5h16l-6 8v6l-4-2v-4z'],
  tri: ['M8 4v16', 'M5 7l3-3 3 3', 'M16 20V4', 'M13 17l3 3 3-3'],
  'tri-croissant': ['M12 20V4', 'M6 10l6-6 6 6'],
  'tri-decroissant': ['M12 4v16', 'M6 14l6 6 6-6'],
  plus: ['M12 5v14', 'M5 12h14'],
  corbeille: ['M4 7h16', 'M10 11v6', 'M14 11v6', 'M6 7l1 13h10l1-13', 'M9 7V4h6v3'],
  crayon: ['M4 20h4l11-11-4-4L4 16z', 'M13 7l4 4'],
  oeil: ['M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12z', 'circle:12,12,3'],
  'oeil-barre': ['M3 3l18 18', 'M10.6 6.3A11 11 0 0 1 12 6c6.5 0 10 6 10 6a17 17 0 0 1-3.2 3.7', 'M6.6 6.6C3.8 8.4 2 12 2 12s3.5 6 10 6c1.5 0 2.8-.3 4-.8', 'M9.9 9.9a3 3 0 0 0 4.2 4.2'],
  telecharger: ['M12 4v12', 'M7 11l5 5 5-5', 'M4 20h16'],
  televerser: ['M12 16V4', 'M7 9l5-5 5 5', 'M4 20h16'],
  calendrier: ['rect:4,5,16,16,2', 'M4 10h16', 'M8 3v4', 'M16 3v4'],
  horloge: ['circle:12,12,9', 'M12 7v5l3 2'],
  fermer: ['M6 6l12 12', 'M18 6L6 18'],
  parametres: ['circle:12,12,3', 'M12 2v3', 'M12 19v3', 'M2 12h3', 'M19 12h3', 'M4.9 4.9l2.1 2.1', 'M17 17l2.1 2.1', 'M4.9 19.1L7 17', 'M17 7l2.1-2.1'],
  deconnexion: ['M10 4H5v16h5', 'M14 8l4 4-4 4', 'M9 12h9'],
  'tableau-de-bord': ['rect:3,3,8,8,1', 'rect:13,3,8,5,1', 'rect:13,10,8,11,1', 'rect:3,13,8,8,1'],
  document: ['M6 3h8l4 4v14H6z', 'M14 3v4h4', 'M9 12h6', 'M9 16h6'],
  imprimer: ['M6 8V3h12v5', 'rect:4,8,16,8,2', 'M6 14h12v7H6z'],
  dossier: ['M3 6h6l2 2h10v11H3z'],
  cloche: ['M6 16V11a6 6 0 0 1 12 0v5l2 2H4z', 'M10 21h4'],
  'tendance-haut': ['M3 17l6-6 4 4 8-8', 'M15 7h6v6'],
  'tendance-bas': ['M3 7l6 6 4-4 8 8', 'M15 17h6v-6'],
  points: ['M5 12h.01', 'M12 12h.01', 'M19 12h.01'],
  soleil: ['circle:12,12,4', 'M12 2v2', 'M12 20v2', 'M2 12h2', 'M20 12h2', 'M4.9 4.9l1.4 1.4', 'M17.7 17.7l1.4 1.4', 'M4.9 19.1l1.4-1.4', 'M17.7 6.3l1.4-1.4'],
  lune: ['M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z'],
  ecran: ['rect:3,4,18,12,2', 'M8 20h8', 'M12 16v4'],
  pause: ['M8 5v14', 'M16 5v14'],
  lecture: ['M7 4l12 8-12 8z'],
};

const formes = traces[nom].map((trace) => {
  if (trace.startsWith('circle:')) {
    const [cx, cy, r] = trace.slice(7).split(',');
    return { type: 'circle' as const, cx, cy, r };
  }
  if (trace.startsWith('rect:')) {
    const [x, y, w, h, rx] = trace.slice(5).split(',');
    return { type: 'rect' as const, x, y, w, h, rx };
  }
  return { type: 'path' as const, d: trace };
});
---
<svg
  width={taille}
  height={taille}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  class={classe}
>
  {formes.map((forme) =>
    forme.type === 'circle' ? (
      <circle cx={forme.cx} cy={forme.cy} r={forme.r}></circle>
    ) : forme.type === 'rect' ? (
      <rect x={forme.x} y={forme.y} width={forme.w} height={forme.h} rx={forme.rx}></rect>
    ) : (
      <path d={forme.d}></path>
    ),
  )}
</svg>
