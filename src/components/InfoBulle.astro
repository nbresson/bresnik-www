---
import Icone from './Icone.astro';

interface Props {
  id: string;
  texte: string;
  /** Libellé du déclencheur pour les lecteurs d'écran quand seul l'icône est affichée. */
  libelle?: string;
}

const { id, texte, libelle = 'Plus d\'informations' } = Astro.props;
---
<span class="group relative inline-flex">
  <button type="button" aria-describedby={id} aria-label={libelle} class="inline-flex size-11 items-center justify-center rounded-full text-encre-2 hover:text-cobalt">
    <slot><Icone nom="information" taille={20} /></slot>
  </button>
  <span
    role="tooltip"
    id={id}
    class="pointer-events-none invisible absolute bottom-full left-1/2 z-10 mb-1 w-max max-w-[260px] -translate-x-1/2 rounded-bouton bg-encre px-3 py-2 text-[14px] leading-[1.4] text-blanc opacity-0 transition-opacity duration-150 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100"
  >
    {texte}
  </span>
</span>
