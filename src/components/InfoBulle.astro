---
import Icone from './Icone.astro';

interface Props {
  id: string;
  texte: string;
  /** Libellé du déclencheur pour les lecteurs d'écran quand seul l'icône est affichée. */
  libelle?: string;
  /** `compacte` : bouton de 28 px pour une liste dense (cible tactile minimale respectée). */
  taille?: 'normale' | 'compacte';
}

const { id, texte, libelle = 'Plus d\'informations', taille = 'normale' } = Astro.props;
// Compacte : 20 px visibles, zone de clic de 44 px en pseudo-élément, sans agrandir la ligne de texte.
const classeBouton = taille === 'compacte' ? "relative size-5 align-[-4px] before:absolute before:-inset-3 before:content-['']" : 'size-11';
---
<span class="group relative inline-flex">
  <button type="button" aria-describedby={id} aria-label={libelle} class={`inline-flex items-center justify-center rounded-full text-encre-2 hover:text-cobalt ${classeBouton}`}>
    <slot><Icone nom="information" taille={taille === 'compacte' ? 16 : 20} /></slot>
  </button>
  <span
    role="tooltip"
    id={id}
    class="pointer-events-none invisible absolute bottom-full left-1/2 z-10 mb-1 w-max max-w-[260px] -translate-x-1/2 rounded-bouton bg-bande px-3 py-2 text-[15px] leading-[1.4] text-bande-texte opacity-0 transition-opacity duration-150 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100"
  >
    {texte}
  </span>
</span>
