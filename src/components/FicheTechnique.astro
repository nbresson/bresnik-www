---
import type { CollectionEntry } from 'astro:content';
import Bouton from './Bouton.astro';
import ListeDefinitions from './ListeDefinitions.astro';
import { actionProduit, libelleAcces } from '../lib/produits';
import { glypheAcces, glypheModules } from '../lib/glyphes';

interface Props {
  produit: CollectionEntry<'produits'>;
}

const { produit } = Astro.props;
const action = actionProduit(produit.data.disponibilite, produit.id);
const modules = produit.data.modulesSage.length > 0 ? produit.data.modulesSage.join(', ') : 'Indépendant des modules';
const lignes = [
  { libelle: 'Plateforme', valeur: produit.data.plateforme, icone: 'ecran' as const },
  { libelle: 'Modules Sage', valeur: modules, icone: glypheModules(produit.data.modulesSage) },
  {
    libelle: 'Objets métiers Sage',
    valeur: produit.data.objetsMetiersSage ? 'requis' : 'non requis',
    icone: 'prise' as const,
    aide: produit.data.objetsMetiersSage
      ? 'Couche officielle d\'écriture dans Sage 100 : le logiciel crée et modifie les données comme une saisie dans Sage, avec ses contrôles. Option payante chez Sage, à activer sur le poste.'
      : 'Lit les données sans passer par Sage : rien à activer.',
  },
  { libelle: 'Données', valeur: 'Traitées sur votre poste, rien n\'est envoyé à Bresnik ni à un tiers.', icone: 'bouclier' as const },
  { libelle: 'Accès', valeur: libelleAcces(produit.data.disponibilite), icone: glypheAcces(produit.data.disponibilite) },
];
---
<aside aria-labelledby="fiche-technique" class="flex flex-col gap-5 rounded-cadre border border-ligne bg-blanc p-6 md:p-7 lg:sticky lg:top-6 lg:self-start">
  <h2 id="fiche-technique" class="text-[20px] font-bold">Fiche technique</h2>
  <ListeDefinitions elements={lignes} id="fiche-technique" />
  <div class="h-px bg-ligne"></div>
  {action.actif && action.href ? (
    <Bouton href={action.href} taille="compact" plein>{action.libelle}</Bouton>
  ) : (
    <div class="flex flex-col gap-2">
      <Bouton desactive taille="compact" plein aria-describedby="mention-acces">{action.libelle}</Bouton>
      <p id="mention-acces" class="technique text-center">{action.mention}</p>
    </div>
  )}
  <p class="text-[14px] leading-[1.5] text-encre-2">
    Une question technique avant ? <a href={`/contact/?produit=${produit.id}`} class="underline underline-offset-[3px]">Écrivez-moi</a>, le formulaire arrive pré-rempli.
  </p>
</aside>
