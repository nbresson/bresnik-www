---
interface Props {
  valeur: number | string;
  /** Contexte lu par les lecteurs d'écran, par exemple « notifications non lues ». */
  libelle: string;
  ton?: 'cobalt' | 'erreur' | 'neutre';
  class?: string;
}

const { valeur, libelle, ton = 'cobalt', class: classe = '' } = Astro.props;
const tons = {
  cobalt: 'bg-cobalt text-blanc',
  erreur: 'bg-erreur text-blanc',
  neutre: 'bg-papier-2 text-encre',
};
---
<span class={`inline-flex h-5 min-w-5 items-center justify-center rounded-full px-1.5 font-technique text-[12px] font-medium leading-none ${tons[ton]} ${classe}`}>
  {valeur}<span class="sr-only"> {libelle}</span>
</span>
