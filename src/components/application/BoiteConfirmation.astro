---
interface Props {
  id: string;
  titre: string;
  texte: string;
  libelleConfirmer?: string;
  libelleAnnuler?: string;
  danger?: boolean;
  libelleOuverture?: string;
}

const { id, titre, texte, libelleConfirmer = 'Confirmer', libelleAnnuler = 'Annuler', danger = false, libelleOuverture } = Astro.props;
const classeConfirmer = danger
  ? 'bg-erreur text-blanc hover:brightness-90'
  : 'bg-cobalt text-blanc hover:bg-cobalt-fonce';
---
{libelleOuverture && (
  <button type="button" data-ouvre-dialogue={id} class={`inline-flex h-11 items-center rounded-bouton px-[18px] text-[15px] font-semibold transition-colors duration-150 ${danger ? 'border-[1.5px] border-erreur text-erreur hover:bg-erreur-teinte' : 'border-[1.5px] border-encre text-encre hover:bg-papier-2'}`}>
    {libelleOuverture}
  </button>
)}
<dialog id={id} role="alertdialog" aria-labelledby={`${id}-titre`} aria-describedby={`${id}-texte`} data-confirmation class="m-auto w-[min(440px,calc(100vw-2rem))] rounded-cadre border border-ligne bg-blanc p-0 text-encre shadow-capture backdrop:bg-voile">
  <form method="dialog" class="flex flex-col gap-4 p-6">
    <h2 id={`${id}-titre`} class="text-[20px] font-bold">{titre}</h2>
    <p id={`${id}-texte`} class="text-[16px] leading-[1.5] text-encre-2">{texte}</p>
    <div class="flex flex-wrap justify-end gap-3 pt-2">
      <button type="submit" value="annuler" autofocus class="inline-flex h-11 items-center rounded-bouton border-[1.5px] border-encre px-[18px] text-[15px] font-semibold text-encre transition-colors duration-150 hover:bg-papier-2">{libelleAnnuler}</button>
      <button type="submit" value="confirmer" class={`inline-flex h-11 items-center rounded-bouton px-[18px] text-[15px] font-semibold transition-colors duration-150 ${classeConfirmer}`}>{libelleConfirmer}</button>
    </div>
  </form>
</dialog>

<script>
  import '../../scripts/dialogues';
</script>
