---
import Icone from '../Icone.astro';
import type { NomIcone } from '../Icone.astro';

interface Props {
  icone: NomIcone;
  libelle: string;
  variante?: 'primaire' | 'secondaire' | 'discret';
  href?: string;
  type?: 'button' | 'submit';
  desactive?: boolean;
  class?: string;
}

const { icone, libelle, variante = 'discret', href, type = 'button', desactive = false, class: classe = '' } = Astro.props;
const variantes = {
  primaire: 'bg-cobalt text-blanc hover:bg-cobalt-fonce hover:text-blanc',
  secondaire: 'border-[1.5px] border-encre text-encre hover:bg-papier-2 hover:text-encre',
  discret: 'text-encre-2 hover:bg-papier-2 hover:text-cobalt',
};
const classes = `inline-flex size-11 items-center justify-center rounded-bouton transition-colors duration-150 ${variantes[variante]} ${desactive ? 'cursor-not-allowed opacity-60' : ''} ${classe}`;
---
{href && !desactive ? (
  <a href={href} class={classes} aria-label={libelle} title={libelle}><Icone nom={icone} taille={20} /></a>
) : (
  <button type={type} class={classes} aria-label={libelle} title={libelle} disabled={desactive}><Icone nom={icone} taille={20} /></button>
)}
