---
interface Props {
  class?: string;
}

const { class: classe = '' } = Astro.props;
---
<div class={`flex flex-col gap-3 rounded-carte border border-ligne bg-blanc p-3 md:flex-row md:items-center md:justify-between ${classe}`}>
  <div class="flex flex-col gap-3 md:flex-row md:items-center">
    <slot name="recherche" />
    <slot name="filtres" />
  </div>
  <div class="flex flex-wrap items-center gap-2">
    <slot name="actions" />
  </div>
</div>
