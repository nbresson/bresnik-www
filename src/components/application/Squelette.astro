---
interface Props {
  lignes?: number;
  avecTitre?: boolean;
  class?: string;
}

const { lignes = 3, avecTitre = true, class: classe = '' } = Astro.props;
const largeurs = ['w-full', 'w-11/12', 'w-4/5', 'w-2/3', 'w-5/6'];
---
<div class={`flex flex-col gap-3 ${classe}`} aria-busy="true" aria-live="polite">
  <span class="sr-only">Chargement en cours</span>
  {avecTitre && <span class="h-6 w-1/2 animate-pulse rounded-[4px] bg-papier-2"></span>}
  {Array.from({ length: lignes }, (_, index) => (
    <span class={`h-4 animate-pulse rounded-[4px] bg-papier-2 ${largeurs[index % largeurs.length]}`}></span>
  ))}
</div>
