---
interface Props {
  ton: 'actif' | 'inactif' | 'attente' | 'erreur';
  libelle: string;
  class?: string;
}

const { ton, libelle, class: classe = '' } = Astro.props;
const points = {
  actif: 'bg-succes',
  inactif: 'bg-encre-2',
  attente: 'bg-ambre',
  erreur: 'bg-erreur',
};
---
<span class={`inline-flex items-center gap-2 text-[14px] ${classe}`}>
  <span class={`size-2.5 shrink-0 rounded-full ${points[ton]}`} aria-hidden="true"></span>
  {libelle}
</span>
