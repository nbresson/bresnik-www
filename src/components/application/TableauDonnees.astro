---
import Icone from '../Icone.astro';
import type { NomIcone } from '../Icone.astro';

type Ligne = Record<string, string | number>;

interface Props {
  legende: string;
  colonnes: { cle: string; libelle: string; numerique?: boolean; tri?: 'croissant' | 'decroissant' | 'aucun' }[];
  lignes: Ligne[];
  cleId: string;
  selection?: boolean;
  actions?: { libelle: string; icone: NomIcone; href: (ligne: Ligne) => string }[];
  class?: string;
}

const { legende, colonnes, lignes, cleId, selection = false, actions = [], class: classe = '' } = Astro.props;
const ariaSort = (tri?: string) => (tri === 'croissant' ? 'ascending' : tri === 'decroissant' ? 'descending' : undefined);
const classeCellule = (numerique?: boolean) => (numerique ? 'text-right font-technique tabular-nums' : 'text-left');
---
<bk-tableau class={`block overflow-x-auto rounded-carte border border-ligne bg-blanc ${classe}`}>
  <table class="w-full border-collapse text-[15px]">
    <caption class="sr-only">{legende}</caption>
    <thead>
      <tr class="border-b-2 border-encre bg-blanc">
        {selection && (
          <th scope="col" class="w-11 px-3 py-3">
            <input type="checkbox" data-tout aria-label="Sélectionner toutes les lignes" class="size-5 accent-cobalt" />
          </th>
        )}
        {colonnes.map((colonne, index) => (
          <th scope="col" aria-sort={ariaSort(colonne.tri)} data-sens={colonne.tri} data-index={index} data-numerique={colonne.numerique ? '' : undefined} class={`group px-4 py-3 font-semibold ${classeCellule(colonne.numerique)}`}>
            {colonne.tri ? (
              <button type="button" data-trier class={`inline-flex items-center gap-1 rounded-[4px] hover:text-cobalt ${colonne.numerique ? 'flex-row-reverse' : ''}`}>
                {colonne.libelle}
                <Icone nom="tri" taille={16} class="hidden text-encre-2 group-data-[sens=aucun]:inline" />
                <Icone nom="tri-croissant" taille={16} class="hidden text-cobalt group-data-[sens=croissant]:inline" />
                <Icone nom="tri-decroissant" taille={16} class="hidden text-cobalt group-data-[sens=decroissant]:inline" />
                <span class="sr-only">, trier</span>
              </button>
            ) : (
              colonne.libelle
            )}
          </th>
        ))}
        {actions.length > 0 && <th scope="col" class="px-4 py-3 text-right font-semibold"><span class="sr-only">Actions</span></th>}
      </tr>
    </thead>
    <tbody>
      {lignes.map((ligne) => (
        <tr class="border-b border-ligne last:border-b-0 odd:bg-blanc even:bg-papier hover:bg-cobalt-teinte/40">
          {selection && (
            <td class="px-3 py-2.5">
              <input type="checkbox" data-ligne aria-label={`Sélectionner la ligne ${ligne[cleId]}`} class="size-5 accent-cobalt" />
            </td>
          )}
          {colonnes.map((colonne, index) =>
            index === 0 ? (
              <th scope="row" class={`px-4 py-2.5 font-semibold ${classeCellule(colonne.numerique)}`}>{ligne[colonne.cle]}</th>
            ) : (
              <td class={`px-4 py-2.5 ${classeCellule(colonne.numerique)}`}>{ligne[colonne.cle]}</td>
            ),
          )}
          {actions.length > 0 && (
            <td class="px-2 py-1.5">
              <div class="flex justify-end gap-1">
                {actions.map((action) => (
                  <a href={action.href(ligne)} aria-label={`${action.libelle} ${ligne[cleId]}`} class="inline-flex size-9 items-center justify-center rounded-bouton text-encre-2 hover:bg-papier-2 hover:text-cobalt">
                    <Icone nom={action.icone} taille={18} />
                  </a>
                ))}
              </div>
            </td>
          )}
        </tr>
      ))}
    </tbody>
  </table>
</bk-tableau>

<script>
  import { comparerValeurs, sensSuivant, type SensTri } from '../../lib/tri';

  class Tableau extends HTMLElement {
    connectedCallback() {
      const corps = this.querySelector('tbody');
      const entetes = Array.from(this.querySelectorAll<HTMLTableCellElement>('thead th[data-sens]'));
      if (!corps) return;
      const decalage = this.querySelector('thead th input[data-tout]') ? 1 : 0;

      for (const entete of entetes) {
        entete.querySelector('[data-trier]')?.addEventListener('click', () => {
          const sens = sensSuivant((entete.dataset.sens as SensTri) ?? 'aucun');
          const index = Number(entete.dataset.index) + decalage;
          const numerique = entete.hasAttribute('data-numerique');
          for (const autre of entetes) {
            const actif = autre === entete;
            autre.dataset.sens = actif ? sens : 'aucun';
            if (actif) autre.setAttribute('aria-sort', sens === 'croissant' ? 'ascending' : 'descending');
            else autre.removeAttribute('aria-sort');
          }
          const lignes = Array.from(corps.querySelectorAll<HTMLTableRowElement>('tr'));
          lignes.sort((a, b) => {
            const va = a.cells[index]?.textContent?.trim() ?? '';
            const vb = b.cells[index]?.textContent?.trim() ?? '';
            return sens === 'croissant' ? comparerValeurs(va, vb, numerique) : comparerValeurs(vb, va, numerique);
          });
          corps.replaceChildren(...lignes);
        });
      }

      const tout = this.querySelector<HTMLInputElement>('input[data-tout]');
      const cases = () => Array.from(this.querySelectorAll<HTMLInputElement>('input[data-ligne]'));
      tout?.addEventListener('change', () => { for (const c of cases()) c.checked = tout.checked; });
      this.addEventListener('change', (evenement) => {
        if (!(evenement.target as Element).matches('input[data-ligne]') || !tout) return;
        const liste = cases();
        const cochees = liste.filter((c) => c.checked).length;
        tout.checked = cochees === liste.length && liste.length > 0;
        tout.indeterminate = cochees > 0 && cochees < liste.length;
      });
    }
  }
  if (!customElements.get('bk-tableau')) customElements.define('bk-tableau', Tableau);
</script>
