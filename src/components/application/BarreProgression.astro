---
interface Props {
  libelle: string;
  valeur: number;
  max: number;
  unite?: string;
  /** Seuils en pourcentage à partir desquels la barre passe en ambre puis en erreur. */
  seuils?: { attention: number; alerte: number };
  class?: string;
}

const { libelle, valeur, max, unite = '', seuils = { attention: 80, alerte: 95 }, class: classe = '' } = Astro.props;
const pourcentage = max > 0 ? Math.min(100, Math.round((valeur / max) * 100)) : 0;
const ton = pourcentage >= seuils.alerte ? 'accent-erreur' : pourcentage >= seuils.attention ? 'accent-ambre' : 'accent-cobalt';
const identifiant = `progression-${libelle.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
---
<div class={`flex flex-col gap-1.5 ${classe}`}>
  <div class="flex items-baseline justify-between gap-4">
    <label for={identifiant} class="text-[14px] font-semibold">{libelle}</label>
    <span class="technique tabular-nums">{valeur}{unite} / {max}{unite} · {pourcentage} %</span>
  </div>
  <progress id={identifiant} value={valeur} max={max} class={`h-2 w-full overflow-hidden rounded-full bg-papier-2 ${ton}`}>{pourcentage} %</progress>
</div>
