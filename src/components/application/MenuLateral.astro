---
import Icone from '../Icone.astro';
import type { NomIcone } from '../Icone.astro';
import Marque from '../Marque.astro';
import Badge from './Badge.astro';

interface Props {
  groupes: { titre?: string; elements: { href: string; libelle: string; icone: NomIcone; actif?: boolean; badge?: number }[] }[];
  class?: string;
}

const { groupes, class: classe = '' } = Astro.props;
---
<nav aria-label="Menu de l'application" class={`flex h-full flex-col gap-6 border-r border-ligne bg-blanc px-3 py-5 ${classe}`}>
  <div class="px-3"><Marque taille="pied" /></div>
  {groupes.map((groupe) => (
    <div class="flex flex-col gap-1">
      {groupe.titre && <p class="eyebrow px-3 pb-1">{groupe.titre}</p>}
      <ul class="flex flex-col gap-0.5">
        {groupe.elements.map((element) => (
          <li>
            <a
              href={element.href}
              aria-current={element.actif ? 'page' : undefined}
              class={`flex h-11 items-center gap-3 rounded-bouton px-3 text-[15px] font-semibold transition-colors duration-150 ${element.actif ? 'bg-cobalt-teinte text-cobalt' : 'text-encre hover:bg-papier-2 hover:text-encre'}`}
            >
              <Icone nom={element.icone} taille={20} class={element.actif ? 'text-cobalt' : 'text-encre-2'} />
              <span class="grow">{element.libelle}</span>
              {element.badge !== undefined && element.badge > 0 && <Badge valeur={element.badge} libelle="éléments en attente" />}
            </a>
          </li>
        ))}
      </ul>
    </div>
  ))}
  <div class="mt-auto border-t border-ligne pt-4">
    <slot name="pied" />
  </div>
</nav>
