---
interface Props {
  nom: string;
  libelle: string;
  actif?: boolean;
  desactive?: boolean;
  aide?: string;
}

const { nom, libelle, actif = false, desactive = false, aide } = Astro.props;
const identifiant = `interrupteur-${nom}`;
const identifiantAide = aide ? `${identifiant}-aide` : undefined;
---
<bk-interrupteur class="flex items-start gap-3">
  <button
    type="button"
    role="switch"
    id={identifiant}
    aria-checked={actif ? 'true' : 'false'}
    aria-labelledby={`${identifiant}-libelle`}
    aria-describedby={identifiantAide}
    disabled={desactive}
    class="group relative mt-0.5 inline-flex h-6 w-11 shrink-0 items-center rounded-full bg-encre-2 transition-colors duration-150 aria-checked:bg-cobalt disabled:cursor-not-allowed disabled:opacity-60"
  >
    <span class="absolute left-0.5 size-5 rounded-full bg-blanc transition-transform duration-150 group-aria-checked:translate-x-5" aria-hidden="true"></span>
  </button>
  <input type="hidden" name={nom} value={actif ? 'oui' : 'non'} />
  <div class="flex flex-col gap-0.5">
    <span id={`${identifiant}-libelle`} class="text-[16px] leading-[1.45]">{libelle}</span>
    {aide && <p id={identifiantAide} class="text-[14px] text-encre-2">{aide}</p>}
  </div>
</bk-interrupteur>

<script>
  class Interrupteur extends HTMLElement {
    connectedCallback() {
      const bouton = this.querySelector<HTMLButtonElement>('[role="switch"]');
      const champ = this.querySelector<HTMLInputElement>('input[type="hidden"]');
      const libelle = this.querySelector<HTMLElement>('[id$="-libelle"]');
      if (!bouton || !champ) return;
      const basculer = () => {
        if (bouton.disabled) return;
        const actif = bouton.getAttribute('aria-checked') !== 'true';
        bouton.setAttribute('aria-checked', String(actif));
        champ.value = actif ? 'oui' : 'non';
        this.dispatchEvent(new CustomEvent('bk-bascule', { detail: { nom: champ.name, actif }, bubbles: true }));
      };
      bouton.addEventListener('click', basculer);
      libelle?.addEventListener('click', basculer);
    }
  }
  if (!customElements.get('bk-interrupteur')) customElements.define('bk-interrupteur', Interrupteur);
</script>
