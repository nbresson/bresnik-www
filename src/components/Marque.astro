---
/**
 * Marque du site : la tuile du logo suivie du mot-symbole « Bresnik », le « k »
 * final en cobalt. Le logo est décoratif (le texte porte le nom) ; le lien mène
 * à l'accueil.
 */
import { Image } from 'astro:assets';
import logo from '../assets/marque/bresnik-logo.png';

interface Props {
  taille?: 'en-tete' | 'pied';
}

const { taille = 'en-tete' } = Astro.props;
const classeTaille = taille === 'en-tete' ? 'text-[24px] lg:text-[26px]' : 'text-[22px]';
const tailleLogo = taille === 'en-tete' ? 28 : 24;
---
<a href="/" class={`inline-flex items-center gap-2.5 font-titres font-bold tracking-[-0.02em] text-encre hover:text-encre ${classeTaille}`} aria-label="Bresnik, accueil">
  <Image src={logo} alt="" width={tailleLogo} height={tailleLogo} densities={[1, 2, 3]} loading="eager" class="block shrink-0 rounded-[6px]" />
  <span>Bresni<span class="text-cobalt">k</span></span>
</a>
