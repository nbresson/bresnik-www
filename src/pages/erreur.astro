---
import Base from '../layouts/Base.astro';
import EnTetePage from '../components/EnTetePage.astro';
import Bouton from '../components/Bouton.astro';
---
<Base titre="Une erreur est survenue" description="Le site a rencontré une erreur temporaire." noindex>
  <EnTetePage eyebrow="Erreur" titre="Une erreur est survenue" sousTitre="Le site a rencontré un problème temporaire. Réessayez dans quelques minutes ; si le problème persiste, écrivez-nous." />
  <div class="conteneur flex flex-col gap-3 pb-16 md:flex-row md:pb-20">
    <Bouton href="/" variante="secondaire" class="max-md:w-full">Retour à l'accueil</Bouton>
    <Bouton href="/contact/" variante="secondaire" class="max-md:w-full">Nous écrire</Bouton>
  </div>
</Base>
