---
import { existsSync } from 'node:fs';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Etiquette from '../../components/Etiquette.astro';
import FilAriane from '../../components/FilAriane.astro';
import LogoProduit from '../../components/LogoProduit.astro';
import Bouton from '../../components/Bouton.astro';
import TuileDomaine from '../../components/TuileDomaine.astro';
import { normaliserFonctionnalites } from '../../lib/glyphes';
import CadreCapture from '../../components/CadreCapture.astro';
import Galerie from '../../components/Galerie.astro';
import { capturesDuProduit } from '../../lib/captures-fichiers';
import FicheTechnique from '../../components/FicheTechnique.astro';
import LienFleche from '../../components/LienFleche.astro';
import Etapes from '../../components/Etapes.astro';
import Icone from '../../components/Icone.astro';
import { actionProduit, libelleCible, produitsSuggeres, tonCible } from '../../lib/produits';
import { produitsPublies } from '../../lib/catalogue';
import { filAriane, logicielApplication } from '../../lib/seo';

export async function getStaticPaths() {
  const produits = await produitsPublies();
  return produits.map((produit) => ({
    params: { id: produit.id },
    props: { produit, suggestions: produitsSuggeres(produits, produit) },
  }));
}

const { produit, suggestions } = Astro.props;
const famille = suggestions.produits;
const { Content } = await render(produit);
const action = actionProduit(produit.data.disponibilite, produit.id);
const captures = capturesDuProduit(produit.id, produit.data.nom, produit.data.captures);
const capturePrincipale = captures.find((c) => c.fichier === produit.data.vedette) ?? captures[0];
const fonctionnalites = normaliserFonctionnalites(produit.data.fonctionnalites);
const chemin = `/produits/${produit.id}/`;
// Image de partage générée par `npm run generer-images` ; à défaut, l'image par défaut du site.
const imagePartage = existsSync(`public/og/produits/${produit.id}.png`) ? `/og/produits/${produit.id}.png` : undefined;
const elementsFilAriane = [{ libelle: 'Accueil', href: '/' }, { libelle: 'Produits', href: '/produits/' }, { libelle: produit.data.nom }];
const donneesStructurees = [
  logicielApplication({ nom: produit.data.nom, description: produit.data.description, chemin, image: produit.data.logo?.src }, Astro.site!),
  filAriane(elementsFilAriane, Astro.site!, chemin),
];

const etapes = [
  { titre: 'Installation locale', texte: 'Application Windows légère à installer sur votre poste ou serveur TSE / RDS, sans dépendance lourde.' },
  { titre: 'Connexion à Sage 100', texte: 'Connexion directe à votre base SQL Server avec vos comptes et droits existants.' },
  { titre: 'Automatisation immédiate', texte: 'Vos flux et gains de temps sont opérationnels dès le premier jour, sans déstabiliser votre Sage.' },
];
---
<Base
  titre={`${produit.data.nom} — ${produit.data.sousTitre}`}
  description={produit.data.description}
  sansSuffixe
  donneesStructurees={donneesStructurees}
  image={imagePartage}
  imageAlt={`${produit.data.nom} — ${produit.data.sousTitre}, par Bresnik`}
>
  <header class="relative overflow-hidden border-b border-ligne">
    <div class="pointer-events-none absolute -top-40 -left-40 size-96 rounded-full bg-cobalt/10 blur-3xl -z-10" aria-hidden="true"></div>
    <div class="conteneur pb-10 pt-10 md:pb-14 md:pt-14">
      <div class="mb-6">
        <FilAriane elements={elementsFilAriane} />
      </div>
      <div class="grid items-center gap-8 lg:grid-cols-12 lg:gap-12">
        <div class="flex flex-col gap-4 lg:col-span-7">
          <div class="flex items-center gap-4 md:gap-5">
            <LogoProduit nom={produit.data.nom} logo={produit.data.logo} taille="grand" />
            <div class="flex flex-col gap-2">
              <Etiquette ton={tonCible(produit.data.cible)} class="self-start">{libelleCible(produit.data.cible)}</Etiquette>
              <h1 class="text-[36px] font-bold leading-[1.06] tracking-[-0.02em] md:text-[56px] md:leading-[1.05] md:tracking-[-0.025em]">{produit.data.nom}</h1>
            </div>
          </div>
          <p class="text-[17px] leading-[1.5] text-encre-2 md:text-[22px] md:leading-[1.4]">{produit.data.accroche}</p>
          <div class="mt-2 flex flex-col gap-3 sm:flex-row sm:items-center">
            {action.actif && action.href ? (
              <Bouton href={action.href} fleche class="max-md:w-full">{action.libelle}</Bouton>
            ) : (
              <>
                <Bouton desactive aria-describedby="mention-action" class="max-md:w-full">{action.libelle}</Bouton>
                <p id="mention-action" class="technique">{action.mention}</p>
              </>
            )}
            {action.actif && <p class="text-[14px] text-encre-2">Démo de 30 min sur vos cas · Réponse sous 48h</p>}
          </div>
          <ul class="flex flex-wrap gap-x-5 gap-y-2 pt-2 text-[14px] text-encre-2" aria-label="Points de repère">
            <li class="flex items-center gap-1.5"><Icone nom="bouclier" taille={16} class="text-cobalt" />Données 100% sur votre poste</li>
            <li class="flex items-center gap-1.5"><Icone nom="prise" taille={16} class="text-cobalt" />Écrit avec contrôles officiels Sage 100</li>
          </ul>
        </div>
        <div class="w-full min-w-0 lg:col-span-5 rounded-cadre glow-saas">
          {capturePrincipale ? (
            <CadreCapture titre={`${produit.data.nom} — ${capturePrincipale.titre}`} image={capturePrincipale.src} alt={capturePrincipale.alt} prioritaire />
          ) : (
            <CadreCapture titre={produit.data.nom} />
          )}
        </div>
      </div>
    </div>
  </header>

  <div class="conteneur grid gap-10 pb-16 pt-10 lg:grid-cols-[minmax(0,1.5fr)_minmax(0,0.8fr)] lg:gap-16 lg:pb-20 lg:pt-16">
    <div class="flex flex-col gap-10 md:gap-12">
      <section class="prose prose-lg max-w-none" aria-label="Description">
        <Content />
      </section>

      <section aria-labelledby="etapes" class="flex flex-col gap-4">
        <h2 id="etapes" class="text-[24px] font-bold leading-[1.15] md:text-[30px]">Mise en œuvre rapide</h2>
        <Etapes etapes={etapes} />
      </section>

      <section aria-labelledby="fonctionnalites" class="flex flex-col gap-4">
        <h2 id="fonctionnalites" class="text-[24px] font-bold leading-[1.15] md:text-[30px]">Fonctionnalités détaillées</h2>
        <TuileDomaine elements={fonctionnalites} colonnes={2} />
      </section>
    </div>

    <FicheTechnique produit={produit} />
  </div>

  {/* Galerie des autres captures d'écran */}
  <section aria-labelledby="captures" class="conteneur flex flex-col gap-4 pb-12 lg:pb-16">
    <h2 id="captures" class="text-[24px] font-bold leading-[1.15] md:text-[30px]">Toutes les captures d'écran</h2>
    {captures.length > 0 ? (
      <Galerie captures={captures} />
    ) : (
      <div class="grid gap-4 md:grid-cols-2">
        <CadreCapture titre={produit.data.nom} />
      </div>
    )}
  </section>

  <section aria-labelledby="accompagnement" class="conteneur pb-12 lg:pb-16">
    <div class="flex flex-col gap-3 rounded-carte border border-ligne bg-papier-2 p-6 md:flex-row md:items-center md:justify-between md:gap-8 md:p-8">
      <div class="flex flex-col gap-1.5">
        <h2 id="accompagnement" class="font-titres text-[24px] font-semibold leading-[1.25]">Besoin d'accompagnement sur ce sujet ?</h2>
        <p class="max-w-[640px] text-[17px] leading-[1.5] text-encre-2">J'interviens aussi en conseil Sage 100 : paramétrage, migration, SQL Server, Objets métiers. Un logiciel et une mission se complètent souvent.</p>
      </div>
      <LienFleche href="/conseil/" class="shrink-0">Le conseil Sage 100</LienFleche>
    </div>
  </section>

  {famille.length > 0 && (
    <section aria-labelledby="famille" class="conteneur flex flex-col gap-5 pb-16 lg:pb-20">
      <h2 id="famille" class="text-[24px] font-bold">{suggestions.memeFamille ? 'Dans la même famille' : 'Les autres logiciels Bresnik'}</h2>
      <div class="grid gap-4 md:grid-cols-3">
        {famille.map((autre) => (
          <a href={`/produits/${autre.id}/`} class="flex items-start gap-4 rounded-carte border border-ligne bg-blanc px-5 py-5 text-encre transition-colors duration-150 hover:border-cobalt hover:text-encre active:bg-papier-2">
            <LogoProduit nom={autre.data.nom} logo={autre.data.logo} taille="petit" />
            <span class="flex flex-col gap-1.5">
              <span class="font-titres text-[20px] font-semibold">{autre.data.nom}</span>
              <span class="text-[15px] text-encre-2">{autre.data.accroche}</span>
            </span>
          </a>
        ))}
      </div>
    </section>
  )}
</Base>
