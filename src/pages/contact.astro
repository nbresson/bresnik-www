---
import Base from '../layouts/Base.astro';
import EnTetePage from '../components/EnTetePage.astro';
import Champ from '../components/Champ.astro';
import Choix from '../components/Choix.astro';
import GroupeChoix from '../components/GroupeChoix.astro';
import Bouton from '../components/Bouton.astro';
import Alerte from '../components/Alerte.astro';
import { produitsPublies } from '../lib/catalogue';
import { emailContact } from '../config/site';
import LogoProduit from '../components/LogoProduit.astro';

const produits = await produitsPublies();
const optionsProduits = [
  { valeur: '', libelle: 'Aucun en particulier', produit: undefined },
  ...produits.map((p) => ({ valeur: p.id, libelle: p.data.nom, produit: p })),
];
// Les prévisualisations de branche (Workers Builds) n'ont pas la variable de
// build de production : elles reçoivent la clé de site de test, inutilisable
// ailleurs que sur les hôtes de test. La production exige la vraie clé.
const brancheBuild = (globalThis as { process?: { env?: Record<string, string | undefined> } }).process?.env?.WORKERS_CI_BRANCH;
const apercuDeBranche = brancheBuild !== undefined && brancheBuild !== 'main';
let cleTurnstile = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '';
if (!cleTurnstile && apercuDeBranche) {
  cleTurnstile = '1x00000000000000000000AA';
  console.warn(`Prévisualisation de la branche ${brancheBuild} : clé de site Turnstile de test utilisée.`);
}
if (import.meta.env.PROD && !cleTurnstile) {
  throw new Error('PUBLIC_TURNSTILE_SITE_KEY manquante : définir la variable de build (voir docs/deploiement.md).');
}
const libellesChamps: Record<string, string> = {
  nom: 'Nom',
  email: 'Email',
  societe: 'Société',
  produit: 'Produit concerné',
  message: 'Message',
  consentement: 'Consentement',
  'cf-turnstile-response': 'Vérification anti-robot',
};
---
<Base titre="Contact et démonstration" description="Demandez une démonstration d'un logiciel Bresnik ou un échange sur votre projet Sage 100 : réponse du consultant sous deux jours ouvrés.">
  <link slot="tete" rel="preconnect" href="https://challenges.cloudflare.com" />
  <EnTetePage eyebrow="Contact" titre="Parlons de votre projet Sage 100." sousTitre="Demandez une démonstration ou décrivez votre besoin. Réponse sous deux jours ouvrés." />
  <div class="conteneur grid gap-10 pb-16 md:pb-20 lg:grid-cols-[minmax(0,1fr)_minmax(0,0.75fr)] lg:gap-16">
    <div class="flex max-w-[640px] flex-col gap-6">
      <div id="zone-etat" class="empty:hidden"></div>
      <div id="erreur" class="hidden target:block">
        <Alerte ton="erreur" titre="Le message n'a pas pu être envoyé">Sans JavaScript, la vérification anti-robot ne peut pas aboutir et le formulaire est refusé. Écrivez directement à <a href={`mailto:${emailContact}`} class="underline underline-offset-[3px]">{emailContact}</a>.</Alerte>
      </div>
      <noscript>
        <Alerte ton="information">Le formulaire a besoin de JavaScript pour la vérification anti-robot. Sans JavaScript, écrivez directement à <a href={`mailto:${emailContact}`} class="underline underline-offset-[3px]">{emailContact}</a>.</Alerte>
      </noscript>
      <form id="formulaire-contact" method="post" action="/api/contact" class="flex flex-col gap-5">
        <Champ nom="nom" libelle="Nom" requis minlength="2" maxlength="100" autocomplete="name" />
        <Champ nom="email" libelle="Email" type="email" requis autocomplete="email" />
        <Champ nom="societe" libelle="Société" facultatif maxlength="100" autocomplete="organization" />
        <fieldset class="flex flex-col gap-2 border-0 p-0">
          <legend class="mb-1 text-[14px] font-semibold">Produit concerné <span class="font-normal text-encre-2">(facultatif)</span></legend>
          <div class="grid gap-2 sm:grid-cols-2">
            {optionsProduits.map((option, index) => (
              <label class="flex min-h-12 cursor-pointer items-center gap-3 rounded-bouton border-[1.5px] border-ligne bg-blanc px-3.5 py-2 transition-colors duration-150 hover:border-encre-2 has-[:checked]:border-cobalt has-[:checked]:bg-cobalt-teinte">
                <input type="radio" name="produit" value={option.valeur} id={index === 0 ? 'champ-produit' : `champ-produit-${option.valeur}`} checked={index === 0} class="size-4 shrink-0 accent-cobalt" />
                {option.produit && <LogoProduit nom={option.produit.data.nom} logo={option.produit.data.logo} taille="mini" />}
                <span class="text-[15px]">{option.libelle}</span>
              </label>
            ))}
          </div>
        </fieldset>
        <Champ nom="message" libelle="Message" type="zone" requis minlength="10" maxlength="5000" />
        <GroupeChoix id="groupe-consentement" legende="Consentement" requis>
          <Choix nom="consentement" valeur="oui" libelle="J'accepte que ces informations servent à répondre à ma demande. Elles ne sont ni stockées sur le site ni transmises à des tiers à d'autres fins." requis />
        </GroupeChoix>
        <p class="text-[14px] text-encre-2">Détails dans la <a href="/confidentialite/" class="underline underline-offset-[3px]">politique de confidentialité</a>.</p>
        <div class="hidden" aria-hidden="true">
          <label>Ne pas remplir <input name="site_web" type="text" tabindex="-1" autocomplete="off" /></label>
        </div>
        <div id="zone-turnstile" data-sitekey={cleTurnstile} class="min-h-[65px]"></div>
        <div class="flex flex-col gap-3">
          <Bouton type="submit" id="bouton-envoyer" class="self-start max-md:w-full" fleche>Envoyer ma demande</Bouton>
          <p id="etat-formulaire" class="text-[14px] text-encre-2" role="status"></p>
        </div>
      </form>
    </div>

    <aside aria-labelledby="apres-message" class="flex flex-col gap-6 self-start rounded-cadre border border-ligne bg-blanc p-6 md:p-7 lg:sticky lg:top-6">
      <h2 id="apres-message" class="text-[20px] font-bold">Après votre message</h2>
      <ol class="flex flex-col gap-5">
        {[
          { titre: 'Je lis votre demande', texte: 'Moi-même, sous deux jours ouvrés, sans passer par un commercial.' },
          { titre: 'On échange trente minutes', texte: 'Sur votre contexte Sage 100, vos volumes et vos contraintes.' },
          { titre: 'Démonstration ou proposition', texte: 'Sur vos cas réels, sans engagement.' },
        ].map((etape, index) => (
          <li class="flex gap-4">
            <span class="inline-flex size-8 shrink-0 items-center justify-center rounded-full bg-cobalt-teinte font-titres text-[15px] font-bold text-cobalt" aria-hidden="true">{index + 1}</span>
            <span class="flex flex-col gap-1">
              <span class="font-semibold"><span class="sr-only">Étape {index + 1} : </span>{etape.titre}</span>
              <span class="text-[15px] leading-[1.5] text-encre-2">{etape.texte}</span>
            </span>
          </li>
        ))}
      </ol>
      <p class="border-t border-ligne pt-5 text-[15px] leading-[1.5] text-encre-2">
        Vous préférez l'email ? <a href={`mailto:${emailContact}`} class="font-semibold text-cobalt underline underline-offset-[3px]">{emailContact}</a>
      </p>
    </aside>
  </div>

  <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit" async defer></script>

  <script>
    // Rendu explicite du widget Turnstile pour qu'il suive le thème du site (clair, sombre, système)
    // et bascule avec le sélecteur de thème, ce que le rendu implicite ne permet pas.
    type Turnstile = {
      render: (conteneur: HTMLElement, options: Record<string, unknown>) => string;
      remove: (id: string) => void;
    };
    // L'id ne doit pas valoir « turnstile » : un id devient une propriété de window et masquerait l'objet de Cloudflare.
    const conteneurTurnstile = document.getElementById('zone-turnstile');
    const themeEffectif = (): 'light' | 'dark' => {
      const force = document.documentElement.dataset.theme;
      if (force === 'light' || force === 'dark') return force;
      return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    };
    let widget: string | undefined;
    const rendreTurnstile = (theme: 'light' | 'dark') => {
      const turnstile = (window as { turnstile?: Turnstile }).turnstile;
      // api.js expose d'abord un objet partiel (ready seul) : attendre la fonction de rendu.
      if (!conteneurTurnstile || typeof turnstile?.render !== 'function') return false;
      if (widget) turnstile.remove(widget);
      conteneurTurnstile.replaceChildren();
      widget = turnstile.render(conteneurTurnstile, { sitekey: conteneurTurnstile.dataset.sitekey, language: 'fr', theme });
      return true;
    };
    let essais = 0;
    const attendreTurnstile = () => {
      if (rendreTurnstile(themeEffectif()) || essais++ > 200) return;
      window.setTimeout(attendreTurnstile, 50);
    };
    attendreTurnstile();
    document.addEventListener('bk-theme', (evenement) => {
      rendreTurnstile((evenement as CustomEvent<{ effectif: 'light' | 'dark' }>).detail.effectif);
    });
    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
      if (!document.documentElement.dataset.theme) rendreTurnstile(themeEffectif());
    });
  </script>

  <script is:inline type="application/json" id="libelles-champs" set:html={JSON.stringify(libellesChamps)}></script>
  <script>
    type Ligne = { champ: string; message: string };
    const libellesChamps: Record<string, string> = JSON.parse(document.getElementById('libelles-champs')?.textContent ?? '{}');
    const formulaire = document.getElementById('formulaire-contact') as HTMLFormElement;
    formulaire.noValidate = true;
    const zoneEtat = document.getElementById('zone-etat') as HTMLElement;
    const bouton = document.getElementById('bouton-envoyer') as HTMLButtonElement;
    const etat = document.getElementById('etat-formulaire') as HTMLElement;
    const parametres = new URLSearchParams(window.location.search);

    const produitDemande = parametres.get('produit');
    const choixProduit = produitDemande ? document.querySelector<HTMLInputElement>(`input[name="produit"][value="${CSS.escape(produitDemande)}"]`) : null;
    if (choixProduit) {
      choixProduit.checked = true;
    }

    const classesAlerte: Record<string, string> = {
      succes: 'border-succes bg-succes-teinte',
      erreur: 'border-erreur bg-erreur-teinte',
    };
    const ancresChamps: Record<string, string> = { consentement: '#choix-consentement-oui' };

    function afficherAlerte(ton: 'succes' | 'erreur', titre: string, lignes: Ligne[]) {
      zoneEtat.replaceChildren();
      const carte = document.createElement('div');
      carte.setAttribute('role', ton === 'erreur' ? 'alert' : 'status');
      carte.tabIndex = -1;
      carte.className = `flex flex-col gap-1 rounded-carte border border-ligne border-l-4 bg-blanc px-4 py-3.5 text-[16px] leading-[1.5] text-encre ${classesAlerte[ton]}`;
      const entete = document.createElement('p');
      entete.className = 'font-semibold';
      entete.textContent = titre;
      carte.append(entete);
      if (lignes.length > 0) {
        const liste = document.createElement('ul');
        liste.className = 'flex flex-col gap-1';
        for (const { champ, message } of lignes) {
          const element = document.createElement('li');
          if (champ && champ !== 'cf-turnstile-response') {
            const lien = document.createElement('a');
            lien.href = ancresChamps[champ] ?? `#champ-${champ}`;
            lien.className = 'underline underline-offset-[3px]';
            lien.textContent = `${libellesChamps[champ] ?? champ} : ${message}`;
            lien.addEventListener('click', (e) => {
              const cible = document.getElementById(lien.hash.slice(1));
              if (cible) {
                e.preventDefault();
                cible.focus();
                cible.scrollIntoView({ block: 'center' });
              }
            });
            element.append(lien);
          } else {
            element.textContent = message;
          }
          liste.append(element);
        }
        carte.append(liste);
      }
      zoneEtat.append(carte);
      carte.focus();
    }

    function marquerErreurs(erreurs: Ligne[]) {
      for (const controle of formulaire.querySelectorAll('[aria-invalid]')) controle.removeAttribute('aria-invalid');
      for (const controle of formulaire.querySelectorAll('[data-describedby-initial]')) {
        const initial = controle.getAttribute('data-describedby-initial');
        if (initial) controle.setAttribute('aria-describedby', initial);
        else controle.removeAttribute('aria-describedby');
        controle.removeAttribute('data-describedby-initial');
      }
      for (const message of formulaire.querySelectorAll('[data-erreur-champ]')) message.remove();
      for (const { champ, message } of erreurs) {
        if (!champ || champ === 'cf-turnstile-response') continue;
        const controle = formulaire.querySelector(`[name="${champ}"]`);
        if (!controle) continue;
        controle.setAttribute('aria-invalid', 'true');
        const idErreur = `erreur-${champ}`;
        const texte = document.createElement('p');
        texte.id = idErreur;
        texte.setAttribute('data-erreur-champ', '');
        texte.className = 'text-[14px] font-semibold text-erreur';
        texte.textContent = message;
        (controle.closest('fieldset') ?? controle.closest('div'))?.append(texte);
        controle.setAttribute('data-describedby-initial', controle.getAttribute('aria-describedby') ?? '');
        const decrits = (controle.getAttribute('aria-describedby') ?? '').split(' ').filter(Boolean);
        if (!decrits.includes(idErreur)) decrits.push(idErreur);
        controle.setAttribute('aria-describedby', decrits.join(' '));
      }
    }

    // Repli sans JavaScript : la page revient avec un état d'erreur dans l'adresse (le succès mène à /contact/merci/).
    if (parametres.get('etat')) document.getElementById('erreur')?.remove();
    if (parametres.get('etat') === 'erreur') {
      const champs = (parametres.get('champs') ?? '').split(',').filter(Boolean);
      afficherAlerte('erreur', 'Le message n\'a pas pu être envoyé', champs.length > 0
        ? champs.map((champ: string) => ({ champ, message: 'à corriger' }))
        : [{ champ: '', message: 'Réessayez dans quelques minutes.' }]);
    }

    formulaire.addEventListener('submit', async (evenement) => {
      evenement.preventDefault();
      const donnees = Object.fromEntries(new FormData(formulaire).entries());
      if (!donnees['cf-turnstile-response']) {
        afficherAlerte('erreur', 'Vérification anti-robot en attente', [{ champ: '', message: 'Attendez que la vérification anti-robot se termine (coche verte), puis réessayez. Si elle n\'apparaît pas, rechargez la page.' }]);
        return;
      }
      bouton.disabled = true;
      bouton.setAttribute('aria-busy', 'true');
      const contenuBouton = bouton.innerHTML;
      bouton.style.minWidth = `${bouton.offsetWidth}px`;
      bouton.innerHTML = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" class="animate-spin"><path d="M21 12a9 9 0 1 1-6.2-8.6"></path></svg>Envoi en cours…';
      etat.textContent = 'Envoi en cours…';
      try {
        const reponse = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(donnees),
        });
        const resultat = (await reponse.json()) as { ok: boolean; erreurs?: Ligne[] };
        if (resultat.ok) {
          // Page de remerciement : une vue comptée par la mesure d'audience, et des liens de continuation.
          window.location.assign('/contact/merci/');
          return;
        }
        marquerErreurs(resultat.erreurs ?? []);
        afficherAlerte('erreur', 'Le message n\'a pas pu être envoyé', resultat.erreurs ?? []);
        (window as { turnstile?: { reset: () => void } }).turnstile?.reset();
      } catch {
        afficherAlerte('erreur', 'Le message n\'a pas pu être envoyé', [{ champ: '', message: 'Vérifiez votre connexion et réessayez.' }]);
        (window as { turnstile?: { reset: () => void } }).turnstile?.reset();
      } finally {
        bouton.disabled = false;
        bouton.removeAttribute('aria-busy');
        bouton.innerHTML = contenuBouton;
        bouton.style.minWidth = '';
        etat.textContent = '';
      }
    });
  </script>
</Base>
