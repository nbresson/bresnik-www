{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bresnik-www",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-02",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  }
}
